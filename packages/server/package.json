{
  "name": "gameplan-server",
  "version": "0.1.2",
  "description": "Sync server for gameplan — serves the web canvas and the plan/diagram annotation API",
  "type": "module",
  "license": "MIT",
  "author": "Appri Technologies (Pvt) Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appriai/gameplan.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/appriai/gameplan#readme",
  "bugs": {
    "url": "https://github.com/appriai/gameplan/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "gameplan-server": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "gameplan-core": "0.1.2",
    "gameplan-web": "0.1.2",
    "fastify": "^5.12.1",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}

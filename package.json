{
  "name": "gameplan-monorepo",
  "private": true,
  "version": "0.1.1",
  "description": "Interactive agent plans on a live Excalidraw canvas",
  "license": "MIT",
  "author": "Appri Technologies (Pvt) Ltd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appriai/gameplan.git"
  },
  "homepage": "https://github.com/appriai/gameplan#readme",
  "bugs": {
    "url": "https://github.com/appriai/gameplan/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/cli",
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w gameplan-core && npm run build -w gameplan-server && npm run build -w gameplan-cli && npm run build -w gameplan-web",
    "test": "npm run test -w gameplan-core && npm run test -w gameplan-server",
    "dev": "npm run dev -w gameplan-web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.18"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "@mermaid-js/parser": "1.2.1",
      "nanoid": "5.1.16"
    },
    "lodash-es": "4.18.1",
    "points-on-path": "0.2.1",
    "vitest": {
      "vite": "6.4.3"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
